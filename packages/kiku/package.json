{
  "name": "@akropolys/kiku",
  "version": "2.0.0",
  "description": "The real-time conversational layer for the living web.",
  "license": "MIT",
  "keywords": [
    "conversational-ai",
    "realtime",
    "voice-ai",
    "chat",
    "search",
    "rag",
    "react",
    "nextjs",
    "akropolys",
    "kiku"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/akropolys/sdk.git"
  },
  "homepage": "https://akropolys.io",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/gen-css.mjs && tsup",
    "dev": "node scripts/gen-css.mjs && tsup --watch"
  },
  "peerDependencies": {
    "@akropolys/sdk": "^1.10.0",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@akropolys/sdk": "workspace:*",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "clsx": "^2.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}